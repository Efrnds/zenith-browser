* {
    color: #f4f4f5;
    font-family: "Noto Sans", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QWidget#centralSurface, QWidget#contentSurface {
    background: #121214;
}

QDialog, QMessageBox {
    background: #18181b;
}

QLineEdit, QSpinBox {
    min-height: 32px;
    color: #f4f4f5;
    background: #202023;
    border: 1px solid #3f3f46;
    border-radius: 4px;
    padding: 0 8px;
    selection-background-color: #5b4fc4;
}

QAbstractItemView {
    color: #f4f4f5;
    background: #121214;
    alternate-background-color: #18181b;
    selection-color: #f4f4f5;
    selection-background-color: #353438;
}

QDialogButtonBox QPushButton {
    border: 1px solid #3f3f46;
}

QWidget#sidebar, QWidget#sidebarBody {
    background: #18181b;
    border-right: 1px solid #27272a;
}

QWidget#revealStrip {
    background: transparent;
}

QLabel#brandLabel {
    color: #fafafa;
    font-size: 19px;
    font-weight: 600;
}

QLabel#sectionLabel {
    color: #a1a1aa;
    font-size: 11px;
    font-weight: 600;
}

QPushButton, QToolButton {
    min-width: 32px;
    min-height: 32px;
    padding: 0 8px;
    color: #d4d4d8;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
}

QPushButton:hover, QToolButton:hover {
    color: #fafafa;
    background: #202023;
}

QPushButton:pressed, QToolButton:pressed {
    background: #27272a;
}

QPushButton:focus, QToolButton:focus, QLineEdit:focus, QListWidget:focus, QComboBox:focus, QSpinBox:focus, QCheckBox:focus {
    border: 1px solid #8b7cf6;
}

QPushButton#workspaceButton:checked {
    color: #ffffff;
    background: #353438;
    border-color: #46454b;
}

QPushButton#workspaceButton {
    padding: 0;
    font-family: "Noto Color Emoji", "Noto Sans Symbols 2", sans-serif;
    font-size: 16px;
}

QPushButton#newTabButton {
    text-align: left;
    padding-left: 12px;
    color: #a1a1aa;
    background: transparent;
    border-color: transparent;
    font-weight: 400;
}

QPushButton#newTabButton:hover {
    color: #f4f4f5;
    background: #202023;
    border-color: transparent;
}

QListWidget#tabList {
    background: transparent;
    border: 0;
    outline: 0;
}

QListWidget#essentialsList, QTreeWidget#tabTree {
    background: transparent;
    border: 0;
    outline: 0;
}

QListWidget#essentialsList::item {
    margin: 2px;
    border: 1px solid transparent;
    border-radius: 8px;
}

QListWidget#essentialsList::item:hover {
    background: #202023;
}

QListWidget#essentialsList::item:selected {
    background: #27272a;
    border-color: #3f3f46;
}

QScrollArea#tabScroll, QWidget#tabScrollViewport, QWidget#tabHost, QWidget#folderGroup {
    background: transparent;
    border: 0;
}

QWidget#folderHeader {
    background: transparent;
}

QLabel#folderName, QToolButton#folderTitleButton {
    min-width: 0;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    text-align: left;
    color: #f4f4f5;
    font-weight: 600;
}

QToolButton#folderToggleButton {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
}

QListWidget#tabList::item {
    margin: 2px 6px;
    padding: 0;
    border-radius: 8px;
}

QListWidget#tabList::item:hover {
    background: #202023;
}

QListWidget#tabList::item:selected {
    background: #27272a;
}

QWidget#tabItem {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
}

QWidget#tabItem:hover {
    background: #202023;
}

QWidget#tabItem[active="true"] {
    background: #27272a;
}

QWidget#tabItem:focus {
    border-color: #8b7cf6;
}

QLabel#tabTitle {
    color: #d4d4d8;
}

QLabel#sleepIndicator {
    color: #8b7cf6;
    font-size: 11px;
}

QToolButton#closeTabButton {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    color: #a1a1aa;
}

QWidget#urlBar {
    background: #121214;
    border-bottom: 1px solid #27272a;
}

QWidget#addressSurface {
    background: #1c1c1f;
    border: 1px solid #323238;
    border-radius: 8px;
}

QWidget#addressSurface[focused="true"] {
    border-color: #8b7cf6;
}

QWidget#urlBar QToolButton {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
}

QToolButton#securityIndicator {
    color: #a1a1aa;
    min-width: 42px;
    max-width: 42px;
    min-height: 26px;
    max-height: 26px;
    padding: 0;
}

QLineEdit#addressInput {
    min-height: 36px;
    color: #f4f4f5;
    background: transparent;
    border: 0;
    padding: 0 8px;
    selection-background-color: #5b4fc4;
}

QLineEdit#addressInput:focus {
    border: 0;
}

QLineEdit#addressInput QToolButton {
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

QSplitter::handle {
    background: #27272a;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QScrollBar:vertical {
    width: 8px;
    margin: 2px;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 24px;
    background: #3f3f46;
    border-radius: 4px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QToolTip {
    color: #f4f4f5;
    background: #27272a;
    border: 1px solid #3f3f46;
    padding: 5px;
}

QMenu {
    color: #f4f4f5;
    background: #202023;
    border: 1px solid #3f3f46;
    padding: 5px;
}

QMenu::item {
    min-height: 28px;
    padding: 2px 24px 2px 10px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: #323236;
}

QMenu::separator {
    height: 1px;
    margin: 5px 7px;
    background: #3f3f46;
}

QWidget#settingsPage {
    background: #121214;
}

QListWidget#settingsNavigation {
    background: #18181b;
    border: 0;
    outline: 0;
}

QListWidget#settingsNavigation::item {
    min-height: 38px;
    padding: 0 10px;
    border-radius: 7px;
}

QListWidget#settingsNavigation::item:hover {
    background: #202023;
}

QListWidget#settingsNavigation::item:selected {
    background: #27272a;
}

QLabel#settingsHeading {
    color: #fafafa;
    font-size: 26px;
    font-weight: 700;
}

QLabel#settingsDescription, QLabel#settingsStatus {
    color: #a1a1aa;
}

QPushButton#settingsBackButton {
    text-align: left;
}

QComboBox {
    min-height: 34px;
    padding: 0 10px;
    color: #f4f4f5;
    background: #202023;
    border: 1px solid #3f3f46;
    border-radius: 7px;
}

QCheckBox {
    min-height: 32px;
    spacing: 9px;
}

QScrollArea, QScrollArea > QWidget > QWidget { background: #121214; border: 0; }
QPushButton:disabled, QToolButton:disabled { color: #a1a1aa; }
QCheckBox::indicator { width: 18px; height: 18px; border: 1px solid #3f3f46; border-radius: 4px; background: #202023; }
QCheckBox::indicator:checked { background: #8b7cf6; border: 5px solid #202023; }
QCheckBox::indicator:hover { border-color: #8b7cf6; }
QComboBox::drop-down { width: 22px; border: 0; }
QComboBox::down-arrow { image: url(:/icons/chevron-down.svg); width: 12px; height: 12px; }
QProgressBar { background: #202023; border: 0; }
QProgressBar::chunk { background: #8b7cf6; }

QLabel#workspaceHeading { font-weight: 600; color: #a1a1aa; }
QTabBar#workspaceTabs { background: transparent; }
QTabBar#workspaceTabs::tab {
    min-width: 22px; min-height: 30px; padding: 0 3px; margin: 0 2px;
    border: 1px solid transparent; border-radius: 6px; color: #a1a1aa;
}
QTabBar#workspaceTabs::tab:selected { color: #8b7cf6; background: #27272a; }
QTabBar#workspaceTabs::tab:hover { background: #202023; }
QTabBar#workspaceTabs:focus { border: 1px solid #8b7cf6; border-radius: 6px; }
QTabBar#workspaceTabs QToolButton { min-width: 22px; max-width: 22px; padding: 0; background: #18181b; }
QToolButton#compactButton:checked { background: #27272a; }
